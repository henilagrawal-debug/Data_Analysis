{
  "Airspeed_filter": {
    "expr": "lpf(ARSP_0.Airspeed, 1.0Hz)",
    "recipe": {
      "type": "filter",
      "filtType": "lowpass",
      "input": "ARSP_0.Airspeed",
      "cutoffHz": 1
    }
  },
  "Gamma_derived_deg": {
    "expr": "atand(- XKF1.VD/ ARSP_0.Airspeed)",
    "recipe": {
      "type": "expr",
      "input": "atand(- XKF1.VD/ ARSP_0.Airspeed)"
    }
  },
  "Pitch_filter": {
    "expr": "lpf(ATT.Pitch, 0.7Hz)",
    "recipe": {
      "type": "filter",
      "filtType": "lowpass",
      "input": "ATT.Pitch",
      "cutoffHz": 0.7
    }
  },
  "Roll_filtered": {
    "expr": "lpf(ATT.Roll, 0.9Hz)",
    "recipe": {
      "type": "filter",
      "filtType": "lowpass",
      "input": "ATT.Roll",
      "cutoffHz": 0.9
    }
  },
  "AOA_derived_deg": {
    "expr": "DERIVED.Pitch_filter-DERIVED.Gamma_derived_deg",
    "recipe": {
      "type": "expr",
      "input": "DERIVED.Pitch_filter-DERIVED.Gamma_derived_deg"
    }
  },
  "Dgamma_Dt_derived": {
    "expr": "d(DERIVED.Gamma_derived_deg)/dt [lpf=4.0Hz]",
    "recipe": {
      "type": "derivative",
      "input": "DERIVED.Gamma_derived_deg",
      "cutoffHz": 4
    }
  },
  "Lift_derived": {
    "expr": "62* DERIVED.Dgamma_Dt_derived+62*9.81*cosd( DERIVED.Gamma_derived_deg)",
    "recipe": {
      "type": "expr",
      "input": "62* DERIVED.Dgamma_Dt_derived+62*9.81*cosd( DERIVED.Gamma_derived_deg)"
    }
  },
  "Lift_Kg_derived": {
    "expr": "DERIVED.Lift_derived/9.81",
    "recipe": {
      "type": "expr",
      "input": "DERIVED.Lift_derived/9.81"
    }
  },
  "Load_factor_derived": {
    "expr": "DERIVED.Lift_Kg_derived/62",
    "recipe": {
      "type": "expr",
      "input": "DERIVED.Lift_Kg_derived/62"
    }
  },
  "Thorttle_derived": {
    "expr": "(RCOU.C1-1100)/800*100",
    "recipe": {
      "type": "expr",
      "input": "(RCOU.C1-1100)/800*100"
    }
  },
  "CL_Derived": {
    "expr": "DERIVED.Lift_derived/(0.5*1.19* DERIVED.Airspeed_filter^2*0.9)",
    "recipe": {
      "type": "expr",
      "input": "DERIVED.Lift_derived/(0.5*1.19* DERIVED.Airspeed_filter^2*0.9)"
    }
  },
  "Rudder_map": {
    "expr": "(RCOU.C6-1500)*30/240",
    "recipe": {
      "type": "expr",
      "input": "(RCOU.C6-1500)*30/240"
    }
  },
  "Elevator_map": {
    "expr": "-( RCOU.C13-1500)*30/245",
    "recipe": {
      "type": "expr",
      "input": "-( RCOU.C13-1500)*30/245"
    }
  },
  "Ground_Speed": {
    "expr": "sqrt(XKF1.VE^2+ XKF1.VN^2)",
    "recipe": {
      "type": "expr",
      "input": "sqrt(XKF1.VE^2+ XKF1.VN^2)"
    }
  },
  "Aileorn_deg_ch10": {
    "expr": "(RCOU.C10-1500)*30/230",
    "recipe": {
      "type": "expr",
      "input": "(RCOU.C10-1500)*30/230"
    }
  },
  "AOA_derived_deg_filtered": {
    "expr": "lpf(DERIVED.AOA_derived_deg, 1.2Hz)",
    "recipe": {
      "type": "filter",
      "filtType": "lowpass",
      "input": "DERIVED.AOA_derived_deg",
      "cutoffHz": 1.2
    }
  },
  "D_derived": {
    "expr": "-62* DERIVED.acc_derived+ DERIVED.T_derived-62*9.81*sind( DERIVED.Gamma_derived_deg)",
    "recipe": {
      "type": "expr",
      "input": "-62* DERIVED.acc_derived+ DERIVED.T_derived-62*9.81*sind( DERIVED.Gamma_derived_deg)"
    }
  },
  "J_derived": {
    "expr": "DERIVED.Airspeed_filter/( DERIVED.RPM_derived/60*0.12)",
    "recipe": {
      "type": "expr",
      "input": "DERIVED.Airspeed_filter/( DERIVED.RPM_derived/60*0.12)"
    }
  },
  "L_by_D_derived": {
    "expr": "DERIVED.Lift_derived/ DERIVED.D_derived",
    "recipe": {
      "type": "expr",
      "input": "DERIVED.Lift_derived/ DERIVED.D_derived"
    }
  },
  "RPM_derived": {
    "expr": "39543* DERIVED.Thorttle_derived/100-3792.7",
    "recipe": {
      "type": "expr",
      "input": "39543* DERIVED.Thorttle_derived/100-3792.7"
    }
  },
  "T_derived": {
    "expr": "0.85*8 * 1.19 * (DERIVED.RPM_derived/60)^2 * 0.12^4*(-0.0283 *(DERIVED.J_derived)^2 + -0.917*DERIVED.J_derived +1.3647)",
    "recipe": {
      "type": "expr",
      "input": "0.85*8 * 1.19 * (DERIVED.RPM_derived/60)^2 * 0.12^4*(-0.0283 *(DERIVED.J_derived)^2 + -0.917*DERIVED.J_derived +1.3647)"
    }
  },
  "acc_derived": {
    "expr": "d(DERIVED.Airspeed_filter)/dt [lpf=4.0Hz]",
    "recipe": {
      "type": "derivative",
      "input": "DERIVED.Airspeed_filter",
      "cutoffHz": 4.0
    }
  }
}